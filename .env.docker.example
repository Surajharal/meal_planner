# Copy to .env and adjust. For Docker Compose, DB_HOST is overridden to the `db` service in docker-compose.yml.
GEMINI_API_KEY=

# Optional: stock food photos for recipe thumbnails (search by dish name). https://www.pexels.com/api/
# PEXELS_API_KEY=
USE_POSTGRES=true

# Neon / Vercel: paste the pooled or direct connection string (sslmode=require is typical)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_NAME=meal_planer
DB_USER=meal_planer
DB_PASSWORD=
SECRET_KEY=

# Production: set ENV=production or FLASK_ENV=production (disables console/on-page OTP; requires SMTP for signup).
# ENV=production

# HTTPS (Docker): use Caddy as reverse proxy — start with:
#   docker compose --profile https up
# Then browse https://localhost (not :5010). In .env set:
#   TRUST_PROXY=true
#   SESSION_COOKIE_SECURE=true
#   (or ENV=production, which enables secure cookies by default)
# Edit Caddyfile: for a real domain, replace localhost block; Caddy gets Let's Encrypt certs.
# HTTPS: cookies only sent over TLS (default true when ENV is production). Plain HTTP on port 5010 only: SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SECURE=true
# TRUST_PROXY=false

# Rate limits (flask-limiter). Single container: memory://. Multiple workers: same Redis URL for all instances.
# RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_DEFAULT=400 per hour

# Admin sign-in: /login/admin with ADMIN_USERNAME + ADMIN_PASSWORD (or legacy AUTH_*).
# Optional: AUTH_EMAIL / ADMIN_EMAIL — same password lets you sign in on the main /login tab with that email.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# AUTH_EMAIL=

# Legacy aliases (optional; same as ADMIN_* if unset)
AUTH_USERNAME=
AUTH_PASSWORD=

# AI diet → weekly plan: max empty slots filled per run (1–28, default 28).
# DIET_APPLY_MAX_MEALS=28

# Sign-up OTP: by default sent only by email (never shown on screen). Requires SMTP_* below.
# SIGNUP_OTP_EMAIL_ONLY=true   # default; strict
# SIGNUP_OTP_EMAIL_ONLY=false  # local dev only: allows console OTP if PRINT_OTP_TO_CONSOLE=true
# PRINT_OTP_TO_CONSOLE=true|false  (only when SIGNUP_OTP_EMAIL_ONLY=false; never used when ENV=production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
